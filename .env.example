APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://product_assistant:product_assistant@localhost:5433/product_assistant
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=product-assistant
MINIO_SECURE=false
ADMIN_API_KEY=change-me-before-sharing

# OpenAI-compatible endpoint. API and worker must use the same embedding profile.
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
# BGE-M3 has a fixed 1024-dimensional output; do not request 1536 dimensions.
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32

# Structured semantic assessment and evidence-grounded text answers.
CHAT_PROVIDER=openai
CHAT_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=Qwen/Qwen3-8B
CHAT_API_KEY=
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_TOKENS=2048
CHAT_ENABLE_THINKING=false
CHAT_THINKING_BUDGET=1024
CHAT_STRUCTURED_OUTPUT=json_schema

POSTGRES_DB=product_assistant
POSTGRES_PORT=5433
POSTGRES_USER=product_assistant
POSTGRES_PASSWORD=product_assistant
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
